# Local development only. Never commit real credentials.
NODE_ENV=development
API_PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:3001
DATABASE_URL=postgresql://pioneer:pioneer@localhost:5432/pioneer
REDIS_URL=redis://localhost:6379
READINESS_TIMEOUT_MS=2000
LOG_LEVEL=info
AUTH_TOKEN_ISSUER=http://localhost:4000
AUTH_TOKEN_AUDIENCE=pioneer-clients
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=pioneer-local
S3_ACCESS_KEY=pioneer
S3_SECRET_KEY=pioneer-local-only
MAIL_HOST=localhost
MAIL_PORT=1025
OTEL_SERVICE_NAME=pioneer-api
