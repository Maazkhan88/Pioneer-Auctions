{
  "name": "@pioneer/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint .",
    "migrate:check": "tsx src/database/check-migrations.ts",
    "migrate:up": "tsx src/database/run-migrations.ts",
    "seed:dev": "tsx src/database/seed-dev.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:bidding": "vitest run test/bid-decision.spec.ts test/bidding-service.spec.ts test/bidding-gateway.spec.ts test/bidding-outbox-publisher.spec.ts test/auction-close-service.spec.ts test/bidding-recovery.spec.ts",
    "test:foundation": "vitest run test/foundation.spec.ts test/admin-auctions.spec.ts test/admin-lots-and-payments.spec.ts",
    "test:integration": "vitest run test/bidding-integration.spec.ts",
    "test:race": "vitest run test/bidding-race.spec.ts",
    "test:contract": "vitest run test/contracts.spec.ts",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/platform-socket.io": "11.1.28",
    "@nestjs/websockets": "11.1.28",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.78.0",
    "@opentelemetry/sdk-node": "0.220.0",
    "@pioneer/contracts": "workspace:*",
    "express": "5.2.1",
    "pg": "8.22.0",
    "pino": "10.3.1",
    "redis": "6.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.28",
    "@pioneer/config": "workspace:*",
    "@types/express": "5.0.6",
    "@types/node": "26.1.1",
    "@types/pg": "8.16.0",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.5",
    "supertest": "7.2.2",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
